# Family Hub's settings: the template.
#
# Copy this file to ".env" (in the same folder) and fill it in. Your .env is
# then the ONE file that holds everything personal to your household: every
# address, password, API key and setting. Settings you save later on the Admin
# page (Admin, Hub, Connections) are written into that same .env file.
#
# Your .env never goes to GitHub (.gitignore keeps it out). To give someone
# your whole setup (the .env, the profiles and each program's own setup),
# make a setup file under Admin, Hub, Setup file: one zip locked with a
# passphrase. Guide 7 has the steps.
#
# Lines starting with # are ignored. A value with spaces, # or $ in it is
# safest in single quotes: SMTP_PASS='abcd efgh $ijk'

# --- Basics ---------------------------------------------------------------
# Your time zone, from the list at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# (for example Europe/London, America/New_York, Australia/Sydney).
TZ=Etc/UTC
# The user and group that own the files. On Linux run `id` to see yours.
PUID=1000
PGID=1000
BOOKHUB_PORT=8090

# --- Where things are kept ------------------------------------------------
# Everything lives under ./stack unless you point these somewhere else.
STACK_DIR=./stack
# An existing Calibre library folder (the one containing metadata.db), or
# leave as is and the library manager creates a new one.
LIBRARY_PATH=./stack/library
INGEST_PATH=./stack/ingest
# Where you drop new book files. Family Hub tidies them (unpacks archives, turns
# folders of page images into comics) and hands the books to the library.
INBOX_PATH=./stack/inbox
# Files Family Hub could not use are moved here. Nothing is deleted.
ATTENTION_PATH=./stack/needs-attention
# The folder where your torrent client puts FINISHED book downloads. Leave
# empty to use DATA_ROOT/torrents/books (the bundled qBittorrent's books folder).
DOWNLOADS_PATH=
# Films, TV and their downloads, all on ONE disk (docs/14):
#   DATA_ROOT/torrents/movies, torrents/tv, torrents/books   where qBittorrent downloads
#   DATA_ROOT/media/movies, media/tv                          where Radarr and Sonarr file them
# Keeping both on the same disk lets a finished film be linked into place
# instead of copied, so it takes up its space once while it keeps seeding.
# On the home server, point this at the big storage disk.
DATA_ROOT=./stack/data

# --- Sign-in for the programs' own pages -------------------------------------
# One user name and password for opening Radarr, Sonarr, Prowlarr, Bazarr and
# qBittorrent in a browser. "Connect everything" (Admin, Hub) sets them on each
# program, and qBittorrent's sign-in below follows. Pick your own password.
SERVICES_USER=admin
SERVICES_PASSWORD=

# --- Visuals on Home ----------------------------------------------------------
# Your home town, for the weather visual and the globe (south and west are
# negative). Only ever sent to Open-Meteo for the forecast.
HOME_PLACE=
HOME_LAT=
HOME_LON=
# Optional: a public GitHub repository of your own visuals (your-name/repo-name).
# Family Hub checks it every hour. Without it, the built-in visuals are used.
VISUALS_REPO=
VISUALS_BRANCH=

# --- Links between the services ---------------------------------------------
# Address of the library manager as you type it in a browser. Used for links.
CWA_URL=http://localhost:8083
# Only for removing spare copies of a book (docs/08) and for admins deleting a
# book: an admin account in the library manager. Easier to enter in Family Hub under Admin, Hub, Connections.
CWA_USER=
CWA_PASS=

# The addresses, keys and passwords below can also be entered in Family Hub
# under Admin, Hub, Connections, which writes them into this file.
# Book search. Leave empty until you have set up Prowlarr (docs/05).
# Inside Docker the services reach each other by name, so keep "prowlarr".
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# qBittorrent runs inside the VPN container, so it is reached as "gluetun".
QBITTORRENT_URL=http://gluetun:8080
QBITTORRENT_USER=
QBITTORRENT_PASS=
QBITTORRENT_CATEGORY=

# --- Guests -----------------------------------------------------------------
GUEST_ENABLED=true
# true = the Guest button only works on the home network.
GUEST_LAN_ONLY=true
# Set to true only if Family Hub sits behind a reverse proxy you control.
TRUST_PROXY=false

# Sending books to a Kindle by email (docs/09). Easier to enter in Family Hub
# under Admin, Hub, Connections, which writes them here.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_MAX_MB=

# Community tags from public catalogues (docs/10). On unless set to off.
# Both can also be changed under Admin, Hub, Connections.
TAG_LOOKUPS=
GOOGLE_BOOKS_KEY=
COMIC_VINE_KEY=
HARDCOVER_KEY=

# --- Manga and manhwa by chapter (docs/13) ----------------------------------
# Start it with:  docker compose --profile series up -d
# Inside Docker the services reach each other by name, so keep "suwayomi".
SUWAYOMI_URL=http://suwayomi:4567
# Where the chapters are kept.
SERIES_PATH=./stack/series
# Its own page (port 4567) asks for this user name and password. Pick a
# password; with SUWAYOMI_AUTH_MODE=none the page is open to your whole network.
SUWAYOMI_AUTH_MODE=basic_auth
SUWAYOMI_USER=bookhub
SUWAYOMI_PASS=
# Languages of the sources to search, by short code.
SERIES_LANGUAGES=en

# --- Nightly copy to a second disk (docs/06) --------------------------------
# A folder on ANOTHER disk. Leave empty and no copy is made. After changing
# it run:  docker compose up -d
# Windows example: BACKUP_PATH=D:/BookHubCopy     Linux: BACKUP_PATH=/mnt/disk2/bookhub
BACKUP_PATH=
# on to copy every night (also switchable under Admin, Hub, Connections).
SECOND_COPY=

# --- Reading apps for series: Komga (docs/13) -------------------------------
# Started together with the series server. Pick any password. (Family Hub
# making a Komga account for each person is planned, not built yet.)
KOMGA_URL=http://komga:25600
KOMGA_USER=bookhub@bookhub.local
KOMGA_PASS=

# --- VPN for torrents (docs/14) ---------------------------------------------
# qBittorrent only ever reaches the internet through this VPN. Until it is
# filled in, the VPN does not start, so qBittorrent stays offline: nothing is
# ever downloaded over your own connection.
# ProtonVPN Plus with WireGuard: on account.protonvpn.com open Downloads,
# WireGuard configuration, tick "NAT-PMP (Port Forwarding)", create a config
# and copy its PrivateKey here.
VPN_PROVIDER=protonvpn
VPN_TYPE=wireguard
VPN_WIREGUARD_KEY=
# For OpenVPN instead (VPN_TYPE=openvpn), your provider's OpenVPN user name and password.
VPN_USER=
VPN_PASSWORD=
# Optional: countries to pick servers from, separated by commas (Netherlands,Switzerland).
VPN_COUNTRIES=
# Port forwarding lets other peers reach you. Leave on for ProtonVPN.
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARD_ONLY=on
# Family Hub asks the VPN which port is forwarded and passes it to qBittorrent.
# Pick any long random text; both containers read it from here. REQUIRED:
# Docker refuses to start anything while it is empty, so the VPN's controls
# are never left open.
GLUETUN_URL=http://gluetun:8000
GLUETUN_API_KEY=

# --- Films, TV and subtitles (docs/14) --------------------------------------
# Start them with:  docker compose --profile search --profile torrent --profile media up -d
# Leave the API keys empty: Family Hub reads them from each service's own
# settings file the first time you press "Connect everything" under Admin.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=
# Subtitles: languages as short codes (en, fr), and an optional free
# OpenSubtitles.com account. Easier to enter under Admin, Hub, Connections.
SUBTITLE_LANGUAGES=en
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=

# --- Watching: Jellyfin (docs/14) -------------------------------------------
# On this PC:  docker compose --profile watch up -d  starts a Jellyfin to try.
# On the home server use the Jellyfin you already have: put its address here
# (or under Admin, Hub, Connections) and make an API key in Jellyfin: Dashboard,
# API Keys, +.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# The Jellyfin address you type in a browser, for the Watch buttons.
JELLYFIN_LINK=http://localhost:8096

# --- Ports (optional) --------------------------------------------------------
# Change the number on the left of a clash, e.g. with the server's own Jellyfin.
# CWA_PORT=8083
# PROWLARR_PORT=9696
# QBITTORRENT_PORT=8080
# RADARR_PORT=7878
# SONARR_PORT=8989
# BAZARR_PORT=6767
# JELLYFIN_PORT=8096
# SUWAYOMI_PORT=4567
# KOMGA_PORT=25600
